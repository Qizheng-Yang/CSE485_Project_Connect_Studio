node_modules/
.env

# Large media files - these should be hosted elsewhere or compressed
src/assets/*.png
src/assets/*.jpg
src/assets/*.jpeg
src/assets/*.gif
src/assets/*.svg

# Video files - too large for Git
public/themes/*.mp4
public/themes/*.webm
public/themes/*.ogg

# User uploaded files - too large for Git
backend/uploads/images/*
backend/uploads/videos/*
backend/uploads/audio/*
backend/backend/uploads/*

# Database files - should not be in Git
backend/database/*.db

# System files
.DS_Store
